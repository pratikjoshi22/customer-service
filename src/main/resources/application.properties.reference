# ============================================================================
# APPLICATION.PROPERTIES — Reference File (NOT loaded by Spring Boot)
# ============================================================================
# This file shows the SAME configuration as application.yml but in
# .properties format. It exists purely for learning — to understand
# how YAML keys map to flat property keys.
#
# YAML (nested)                    →  Properties (flat, dot-separated)
# ============================================================================

# ── Application ────────────────────────────────────────────────────────────
# spring.application.name=customer-service

# ── Kafka ──────────────────────────────────────────────────────────────────
# spring.kafka.bootstrap-servers=localhost:19092
# spring.kafka.consumer.group-id=customer-registration-group
# spring.kafka.consumer.auto-offset-reset=earliest
# spring.kafka.consumer.key-deserializer=org.apache.kafka.common.serialization.StringDeserializer
# spring.kafka.consumer.value-deserializer=org.springframework.kafka.support.serializer.JsonDeserializer
# spring.kafka.consumer.properties.spring.json.trusted.packages=*
# spring.kafka.consumer.properties.spring.json.value.default.type=com.example.customerservice.model.dto.CustomerRegistrationEvent
# spring.kafka.listener.concurrency=3

# ── Database (PostgreSQL — default) ───────────────────────────────────────
# spring.datasource.url=jdbc:postgresql://localhost:5433/customerdb
# spring.datasource.username=customer
# spring.datasource.password=customer123
# spring.datasource.driver-class-name=org.postgresql.Driver
# spring.jpa.hibernate.ddl-auto=update
# spring.jpa.show-sql=true
# spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# ── Database (H2 — use with profile "h2") ─────────────────────────────────
# spring.datasource.url=jdbc:h2:mem:customerdb
# spring.datasource.driver-class-name=org.h2.Driver
# spring.datasource.username=sa
# spring.datasource.password=
# spring.h2.console.enabled=true
# spring.h2.console.path=/h2-console
# spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.H2Dialect

# ── App-specific ───────────────────────────────────────────────────────────
# app.kafka.topic.customer-registration=customer-registration

# ── Server ─────────────────────────────────────────────────────────────────
# server.port=8080

# ============================================================================
# HOW TO SWITCH:
#
#   PostgreSQL (default):   mvn spring-boot:run
#   H2 (in-memory):         mvn spring-boot:run -Dspring-boot.run.profiles=h2
#
# You can also set the profile via environment variable:
#   SPRING_PROFILES_ACTIVE=h2 mvn spring-boot:run
# ============================================================================
